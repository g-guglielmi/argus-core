# Copy to a private file (e.g. argus.env) and pass with: docker run --env-file argus.env ...
# Do NOT commit the filled-in version.

# Address the app listens on inside the container
ARGUS_LISTEN=:8080

# Zabbix JSON-RPC API endpoint (the core VM's Zabbix frontend). The token below is a super-admin
# credential sent on every poll: from another host use https (the core appliance serves the API
# over TLS on :8443); plain http is for the same VM only (http://host.docker.internal:8080/...).
ARGUS_ZABBIX_API_URL=https://10.0.0.10:8443/api_jsonrpc.php

# Zabbix API token for read calls (hosts/sensors). Create it in the Zabbix UI under
# Users -> API tokens (assign it to a user with read access), then paste the value here.
# Without it, the health probe still works but the Monitoring view returns an error.
ARGUS_ZABBIX_API_TOKEN=

# Where SQLite + the CA store live (mount a volume here)
ARGUS_DATA_DIR=/data

# First-run only: seeds the initial admin user on an empty database
ARGUS_ADMIN_EMAIL=admin@example.com
ARGUS_ADMIN_PASSWORD=change-me-on-first-login

# Set true when Argus is served over HTTPS (e.g. behind HAProxy) so the session cookie is Secure
ARGUS_COOKIE_SECURE=false

# --- Passkeys (WebAuthn), optional ---
# Passkeys need a real domain (never a bare IP) reached over HTTPS. Leave these unset to
# disable passkeys entirely (password + TOTP still work, including over a private IP).
# RP ID = the registrable domain; RP origins = the full https origin(s), comma-separated.
# ARGUS_RP_ID=monitoring.example.com
# ARGUS_RP_DISPLAY_NAME=Argus
# ARGUS_RP_ORIGINS=https://monitoring.example.com
