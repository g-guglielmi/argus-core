# DHCP the primary NIC via systemd-networkd, independent of cloud-init (which is purged from this
# image). Matches the usual predictable names (enX0 on Xen, ens/enp elsewhere, eth* as a fallback).
# A static address is set from the console menu (argus-console, Network > Configure networking), which
# writes 00-argus-static.network beside this file; that one sorts first, so it wins while it exists.
[Match]
Name=en* eth*

[Network]
DHCP=yes

[DHCPv4]
# Use the DHCP-provided hostname if the server offers one.
UseHostname=yes
