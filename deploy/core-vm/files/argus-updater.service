[Unit]
Description=Argus updater sidecar (one-click core self-update)
Documentation=https://github.com/g-guglielmi/argus-updater
Wants=network-online.target
After=network-online.target docker.service argus-core.service
Requires=docker.service

[Service]
# The second container of the core appliance: the shared argus-updater image in its default core
# (file-channel) mode. It holds the Docker socket (the web-facing core never does) and watches the
# shared /update folder: when an admin clicks "Update now" in Argus - Settings, it pulls the new
# release, recreates the `argus` container cloning its config, verifies health, and rolls back on
# failure. Pin ARGUS_UPDATER_TAG in image.env to hold an updater version instead of latest.
Environment=ARGUS_UPDATER_TAG=latest
Environment=ARGUS_UPDATER_IMAGE=ghcr.io/g-guglielmi/argus-updater
EnvironmentFile=-/etc/argus-core/image.env
TimeoutStartSec=0

Type=oneshot
RemainAfterExit=yes
ExecStartPre=-/usr/bin/docker rm -f argus-updater
ExecStartPre=-/usr/bin/docker pull ${ARGUS_UPDATER_IMAGE}:${ARGUS_UPDATER_TAG}
ExecStart=/usr/bin/docker run -d --name argus-updater --restart unless-stopped \
  -v /var/run/docker.sock:/var/run/docker.sock \
  -v /opt/argus/update:/update \
  -e ARGUS_CORE_CONTAINER=argus \
  ${ARGUS_UPDATER_IMAGE}:${ARGUS_UPDATER_TAG}
ExecStop=-/usr/bin/docker stop argus-updater

[Install]
WantedBy=multi-user.target
