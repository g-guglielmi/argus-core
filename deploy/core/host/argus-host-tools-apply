# argus-host-tools-apply - the last step of a host tools update (DESIGN 14c). The Argus image carries
# the core's host scripts and units; after each core update the argus-updater writes them to the host
# (`argus install-host-tools`), and a container cannot reload systemd, so it drops
# host-tools-apply.json in the shared dir and argus-host-tools.path starts this: reload, enable what
# the marker lists (every timer and path unit of the manifest), re-report. Local, never remote.
set -u
DIR="${ARGUS_STATE_DIR:-/docker/argus-update}"
REQ="$DIR/host-tools-apply.json"
[ -f "$REQ" ] || exit 0
units="$(sed -n 's/.*"enable":"\([^"]*\)".*/\1/p' "$REQ")"
rm -f "$REQ"
systemctl daemon-reload
for u in $units; do
  systemctl enable --now "$u" >/dev/null 2>&1 || logger -t argus-host-tools "could not enable $u"
done
logger -t argus-host-tools "host tools applied (${units:-nothing to enable})"
/usr/local/sbin/argus-os-report || true
