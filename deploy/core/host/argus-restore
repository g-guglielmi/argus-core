class Fail(Exception):
    pass


def say(msg=""):
    print(msg, flush=True)


def run(cmd, *, stdout=None, check=True, timeout=None, env=None, input_bytes=None, stdin=None):
    """stdin is an open file the command reads as its standard input (input_bytes: a few bytes)."""
    feed = {"stdin": stdin} if stdin is not None else {"input": input_bytes}
    try:
        p = subprocess.run(cmd, stdout=stdout if stdout is not None else subprocess.PIPE, stderr=subprocess.PIPE,
                           timeout=timeout, env=env, **feed)
    except FileNotFoundError:
        raise Fail("%s is not installed" % cmd[0])
    if check and p.returncode != 0:
        err = (p.stderr or b"").decode("utf-8", "replace").strip().splitlines()
        raise Fail("%s failed: %s" % (" ".join(cmd[:4]), err[-1] if err else "exit %d" % p.returncode))
    return p


def psql(sql, db="postgres", check=True):
    return run(["runuser", "-u", "postgres", "--", "psql", "-v", "ON_ERROR_STOP=1", "-At", "-d", db, "-c", sql], check=check)


def unit_exists(name):
    return run(["systemctl", "cat", name], check=False).returncode == 0


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def unpack(archive, work, passphrase_file):
    """Decrypt (when needed) and unpack an archive into work; return its manifest."""
    tar = archive
    if archive.endswith(".gpg"):
        home = tempfile.mkdtemp(prefix="gpg-", dir=work)
        os.chmod(home, 0o700)
        tar = os.path.join(work, "archive.tar")
        cmd = ["gpg", "--homedir", home, "--pinentry-mode", "loopback", "--no-symkey-cache", "-o", tar, "-d", archive]
        if passphrase_file:
            cmd[1:1] = ["--batch", "--passphrase-file", passphrase_file]
            run(cmd)
        else:
            say("The archive is encrypted: type its passphrase (Settings, Backups).")
            if subprocess.run(cmd).returncode != 0:
                raise Fail("gpg could not decrypt the archive (wrong passphrase?)")
        run(["gpgconf", "--homedir", home, "--kill", "gpg-agent"], check=False)
    run(["tar", "-xf", tar, "-C", work])
    if tar != archive:
        os.unlink(tar)
    mpath = os.path.join(work, "manifest.json")
    if not os.path.exists(mpath):
        raise Fail("this is not an argus-backup archive (no manifest.json)")
    with open(mpath, encoding="utf-8") as f:
        manifest = json.load(f)
    for name, meta in (manifest.get("parts") or {}).items():
        p = os.path.join(work, name)
        if not os.path.exists(p):
            raise Fail("the archive is missing %s" % name)
        if meta.get("sha256") and sha256(p) != meta["sha256"]:
            raise Fail("%s is damaged (its checksum does not match)" % name)
    return manifest


def installed_versions():
    out = {}
    for pkg in ("zabbix-server-pgsql", "postgresql-17", "timescaledb-2-postgresql-17"):
        p = run(["dpkg-query", "-W", "-f=${Version}", pkg], check=False)
        if p.returncode == 0 and p.stdout.strip():
            out[pkg] = p.stdout.decode().strip()
    return out


def major_minor(v):
    """'1:7.0.31-1+debian13' -> '7.0'; '2.28.3~debian13' -> '2.28'."""
    m = re.search(r"(\d+)\.(\d+)", v.split(":")[-1])
    return m.group(0) if m else ""


def bare_version(v):
    """'2.28.5~debian13-1712' -> '2.28.5': no epoch, no build suffix, what the database calls it."""
    return re.split(r"[~-]", v.split(":")[-1])[0]


def timescaledb_wanted(manifest):
    """The TimescaleDB version the archive's Zabbix dump needs ('2.28.5'); '' when it doesn't say."""
    was = manifest.get("versions") or {}
    return was.get("timescaledb_extension") or bare_version(was.get(TS_META, ""))


def timescaledb_offered(want):
    """The newest build of TimescaleDB `want` that the package lists here have for both packages;
    '' when they have none."""
    offers = {}
    for pkg in (TS_META, TS_LOADER):
        try:
            p = run(["apt-cache", "madison", pkg], check=False)
        except Fail:
            return ""
        offers[pkg] = [l.split("|")[1].strip() for l in p.stdout.decode().splitlines() if l.count("|") >= 2]
    builds = [v for v in offers[TS_META] if bare_version(v) == want and v in offers[TS_LOADER]]
    return max(builds, key=lambda v: [int(n) for n in re.findall(r"\d+", v)]) if builds else ""


def timescaledb_fit(manifest):
    """The TimescaleDB package to install before the dump can be restored: '' when this machine is on
    the version the dump needs (or one of the two is unknown), the full package version when the
    repository here offers it for both packages, None when it does not.

    The package lists of a machine fresh from its image are as old as the image, and a restore is
    what such a machine is for: a version missing from them is looked for once more after reading
    the repositories again, before it is called missing."""
    want, have = timescaledb_wanted(manifest), installed_versions().get(TS_META, "")
    if not want or not have or bare_version(have) == want:
        return ""
    build = timescaledb_offered(want)
    if not build:
        say("==> TimescaleDB %s is not in the package lists here: reading the repositories again" % want)
        try:
            p = run(["apt-get", "update", "-qq", "-o", "DPkg::Lock::Timeout=300"], check=False, timeout=600)
            failed = p.returncode != 0
        except (Fail, subprocess.TimeoutExpired):
            failed = True
        if failed:
            say("!! could not read the package repositories (no internet from this machine?)")
        build = timescaledb_offered(want)
    return build or None


def install_timescaledb(version):
    """Put the TimescaleDB packages on the version the dump was made on (older or newer than what is
    here), hold them, pin their line and restart PostgreSQL on them. Zabbix is stopped by now. A
    failed install leaves the packages, the hold and the pin as they were."""
    say("==> installing TimescaleDB %s, the version the backup was made on" % bare_version(version))
    pkgs = [TS_META, TS_LOADER]
    try:
        with open(TS_PIN, encoding="utf-8") as f:
            pin_was = f.read()
    except OSError:
        pin_was = None
    run(["apt-mark", "unhold"] + pkgs, check=False)
    try:
        os.makedirs(os.path.dirname(TS_PIN), exist_ok=True)
        with open(TS_PIN, "w", encoding="utf-8", newline="\n") as f:
            f.write("Package: timescaledb-2-*\nPin: version %s.*\nPin-Priority: 1001\n" % major_minor(version))
        run(["apt-get", "install", "-y", "--allow-downgrades", "-o", "DPkg::Lock::Timeout=300"] + ["%s=%s" % (p, version) for p in pkgs],
            env=dict(os.environ, DEBIAN_FRONTEND="noninteractive"))
    except (Fail, OSError) as e:
        if pin_was is None:
            if os.path.exists(TS_PIN):
                os.unlink(TS_PIN)
        else:
            with open(TS_PIN, "w", encoding="utf-8", newline="\n") as f:
                f.write(pin_was)
        run(["apt-mark", "hold"] + pkgs, check=False)
        raise Fail("could not install TimescaleDB %s, nothing was restored: %s" % (bare_version(version), e))
    run(["apt-mark", "hold"] + pkgs, check=False)
    run(["systemctl", "restart", "postgresql"], check=False)
    for _ in range(60):
        if psql("select 1", check=False).returncode == 0:
            return
        time.sleep(2)
    raise Fail("PostgreSQL did not answer after its restart on TimescaleDB %s (journalctl -u postgresql)" % bare_version(version))


def version_problems(manifest, timescaledb=True):
    """Why this machine can't take the archive as it is. timescaledb=False leaves TimescaleDB out:
    the restore installs the version the dump needs itself (timescaledb_fit)."""
    have, was = installed_versions(), (manifest.get("versions") or {})
    problems = []
    # PostgreSQL's second number is a patch release (17.11, 17.12): a dump goes from one to the other,
    # and a machine fresh from its image is always a few behind. Zabbix and TimescaleDB change what a
    # database holds with their second number.
    line = {"postgresql-17": lambda v: major_minor(v).split(".")[0]}
    for pkg, label in (("zabbix-server-pgsql", "Zabbix"), ("postgresql-17", "PostgreSQL"), (TS_META, "TimescaleDB")):
        if pkg == TS_META and not timescaledb:
            continue
        same = line.get(pkg, major_minor)
        if pkg in was and pkg in have and same(was[pkg]) != same(have[pkg]):
            problems.append("%s here is %s, the backup was made on %s" % (label, have[pkg], was[pkg]))
    ts_was = was.get("timescaledb_extension", "")
    ts_have = have.get(TS_META, "")
    if timescaledb and ts_was and ts_have and not ts_have.split("~")[0].startswith(ts_was):
        problems.append("the TimescaleDB extension must be %s to restore this dump (installed: %s), and the package "
                        "repository here does not offer it" % (ts_was, ts_have))
    return problems


