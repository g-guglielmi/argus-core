# argus-restore - restore the Argus core from an argus-backup archive (DESIGN section 14e,
# docs/backup-and-restore.md).
#
# Run as root on the core that should take over: a new core VM from the appliance image (first boot
# done, with any values: this replaces them), or a manual install of the same stack. It stops Argus,
# the updater and zabbix-server, puts back the configuration, keys and certificates, recreates the
# Zabbix database from the dump (with TimescaleDB's pre/post-restore steps) and the Argus database,
# then starts everything again. Probes reconnect on their own: the CA they trust comes back with it.
#
# Usage:
#   argus-restore inspect ARCHIVE                show what an archive holds, check it, change nothing
#   argus-restore containers ARCHIVE             print the docker run commands the old core's Argus
#                                                containers ran with (a core installed by hand)
#   argus-restore network ARCHIVE [--yes] [--keep-hostname] [--static]
#                                                give this machine the old core's address and hostname
#   argus-restore restore ARCHIVE [--only files|zabbix|argus] [--yes] [--force] [--passphrase-file F]
# An encrypted archive (.tar.gpg) asks for its passphrase unless --passphrase-file is given.
import argparse
import gzip
import hashlib
import json
import os
import re
import shlex
import shutil
import socket
import subprocess
import sys
import tempfile
import time

WORK_BASE = os.environ.get("ARGUS_BACKUP_DIR", "/var/backups/argus")
CONTAINER = os.environ.get("ARGUS_CONTAINER", "argus")
UPDATER = os.environ.get("ARGUS_UPDATER_CONTAINER", "argus-updater")
APP_UID = 65532  # the Argus container's user
NETWORKD_DIR = os.environ.get("ARGUS_NETWORKD_DIR", "/etc/systemd/network")
# Sorts before the appliance's 10-argus-dhcp.network: systemd-networkd applies the first file that matches.
NETWORKD_FILE = "05-argus-restored.network"


class Fail(Exception):
    pass


def say(msg=""):
    print(msg, flush=True)


def run(cmd, *, stdout=None, check=True, timeout=None, env=None, input_bytes=None):
    try:
        p = subprocess.run(cmd, stdout=stdout if stdout is not None else subprocess.PIPE, stderr=subprocess.PIPE,
                           timeout=timeout, env=env, input=input_bytes)
    except FileNotFoundError:
        raise Fail("%s is not installed" % cmd[0])
    if check and p.returncode != 0:
        err = (p.stderr or b"").decode("utf-8", "replace").strip().splitlines()
        raise Fail("%s failed: %s" % (" ".join(cmd[:4]), err[-1] if err else "exit %d" % p.returncode))
    return p


def psql(sql, db="postgres", check=True):
    return run(["runuser", "-u", "postgres", "--", "psql", "-v", "ON_ERROR_STOP=1", "-At", "-d", db, "-c", sql], check=check)


def unit_exists(name):
    return run(["systemctl", "cat", name], check=False).returncode == 0


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def unpack(archive, work, passphrase_file):
    """Decrypt (when needed) and unpack an archive into work; return its manifest."""
    tar = archive
    if archive.endswith(".gpg"):
        home = tempfile.mkdtemp(prefix="gpg-", dir=work)
        os.chmod(home, 0o700)
        tar = os.path.join(work, "archive.tar")
        cmd = ["gpg", "--homedir", home, "--pinentry-mode", "loopback", "--no-symkey-cache", "-o", tar, "-d", archive]
        if passphrase_file:
            cmd[1:1] = ["--batch", "--passphrase-file", passphrase_file]
            run(cmd)
        else:
            say("The archive is encrypted: type its passphrase (Settings, Backups).")
            if subprocess.run(cmd).returncode != 0:
                raise Fail("gpg could not decrypt the archive (wrong passphrase?)")
        run(["gpgconf", "--homedir", home, "--kill", "gpg-agent"], check=False)
    run(["tar", "-xf", tar, "-C", work])
    if tar != archive:
        os.unlink(tar)
    mpath = os.path.join(work, "manifest.json")
    if not os.path.exists(mpath):
        raise Fail("this is not an argus-backup archive (no manifest.json)")
    with open(mpath, encoding="utf-8") as f:
        manifest = json.load(f)
    for name, meta in (manifest.get("parts") or {}).items():
        p = os.path.join(work, name)
        if not os.path.exists(p):
            raise Fail("the archive is missing %s" % name)
        if meta.get("sha256") and sha256(p) != meta["sha256"]:
            raise Fail("%s is damaged (its checksum does not match)" % name)
    return manifest


def installed_versions():
    out = {}
    for pkg in ("zabbix-server-pgsql", "postgresql-17", "timescaledb-2-postgresql-17"):
        p = run(["dpkg-query", "-W", "-f=${Version}", pkg], check=False)
        if p.returncode == 0 and p.stdout.strip():
            out[pkg] = p.stdout.decode().strip()
    return out


def major_minor(v):
    """'1:7.0.31-1+debian13' -> '7.0'; '2.28.3~debian13' -> '2.28'."""
    m = re.search(r"(\d+)\.(\d+)", v.split(":")[-1])
    return m.group(0) if m else ""


def version_problems(manifest):
    have, was = installed_versions(), (manifest.get("versions") or {})
    problems = []
    for pkg, label in (("zabbix-server-pgsql", "Zabbix"), ("postgresql-17", "PostgreSQL"), ("timescaledb-2-postgresql-17", "TimescaleDB")):
        if pkg in was and pkg in have and major_minor(was[pkg]) != major_minor(have[pkg]):
            problems.append("%s here is %s, the backup was made on %s" % (label, have[pkg], was[pkg]))
    ts_was = was.get("timescaledb_extension", "")
    ts_have = have.get("timescaledb-2-postgresql-17", "")
    if ts_was and ts_have and not ts_have.split("~")[0].startswith(ts_was):
        problems.append("the TimescaleDB extension must be %s to restore this dump (installed: %s)" % (ts_was, ts_have))
    return problems


def describe(manifest, archive):
    v = manifest.get("versions") or {}
    say("Archive:   %s" % os.path.basename(archive))
    say("Made:      %s on %s (Argus %s)" % (manifest.get("created_at", "?"), manifest.get("host", "?"), manifest.get("argus_version") or "?"))
    say("Holds:     %s" % ", ".join(sorted((manifest.get("parts") or {}).keys())))
    say("History:   %s" % ("included" if manifest.get("zabbix_history") else "settings only (no metric history)"))
    for k in ("os", "zabbix-server-pgsql", "postgresql-17", "timescaledb-2-postgresql-17", "timescaledb_extension", "argus_image"):
        if k in v:
            say("  %-28s %s" % (k, v[k]))
    n = manifest.get("network")
    if n:
        say("Network:   %s (%s) on %s, gateway %s, DNS %s, from %s" % (", ".join(n.get("addresses") or []) or "?",
            "DHCP" if n.get("dhcp") else "static", n.get("interface") or "?", n.get("gateway") or "?",
            ", ".join(n.get("dns") or []) or "none", n.get("managed_by") or "?"))


# Environment an image sets for itself: not part of how the container was run.
IMAGE_ENV = {"PATH", "HOME", "HOSTNAME", "TERM", "SSL_CERT_FILE"}


def run_command(c):
    """The docker run command that recreates a container as it ran: name, restart policy, network,
    ports, extra hosts, folders, environment and image."""
    cfg, hc = c.get("Config") or {}, c.get("HostConfig") or {}
    args = ["docker", "run", "-d", "--name", (c.get("Name") or "").lstrip("/")]
    policy = (hc.get("RestartPolicy") or {}).get("Name") or ""
    if policy and policy != "no":
        args += ["--restart", policy]
    net = hc.get("NetworkMode") or ""
    if net and net not in ("default", "bridge"):
        args += ["--network", net]
        ipam = (((c.get("NetworkSettings") or {}).get("Networks") or {}).get(net) or {}).get("IPAMConfig") or {}
        if ipam.get("IPv4Address"):
            args += ["--ip", ipam["IPv4Address"]]
    for cport, binds in sorted((hc.get("PortBindings") or {}).items()):
        port, _, proto = cport.partition("/")
        for bnd in binds or []:
            spec = ((bnd.get("HostIp") + ":") if bnd.get("HostIp") else "") + (bnd.get("HostPort") or "") + ":" + port
            args += ["-p", spec + ("/" + proto if proto and proto != "tcp" else "")]
    for h in hc.get("ExtraHosts") or []:
        args += ["--add-host", h]
    for m in c.get("Mounts") or []:
        ro = "" if m.get("RW", True) else ":ro"
        if m.get("Type") == "bind" and m.get("Source"):
            args += ["-v", "%s:%s%s" % (m["Source"], m["Destination"], ro)]
        elif m.get("Type") == "volume" and m.get("Name"):
            args += ["-v", "%s:%s%s" % (m["Name"], m["Destination"], ro)]
    for e in cfg.get("Env") or []:
        if e.split("=", 1)[0] not in IMAGE_ENV:
            args += ["-e", e]
    args.append(cfg.get("Image") or "")
    return " ".join(shlex.quote(a) for a in args)


def show_containers(work):
    path = os.path.join(work, "containers.json")
    if not os.path.exists(path):
        say("This archive has no container settings (made before they were kept, or Docker didn't say).")
        return 1
    with open(path, encoding="utf-8") as f:
        found = json.load(f)
    say("How the old core's Argus containers ran. On a core installed by hand, create them with these")
    say("(they hold the secret key and the Zabbix API token: keep this output private), then restore.")
    say("A core from the appliance image has its own units instead: restore puts their settings back.")
    for c in found:
        say()
        say(run_command(c))
    return 0


# --- the old core's address -----------------------------------------------------------------------

def ip_json(args):
    p = run(["ip", "-j"] + args, check=False)
    try:
        return json.loads(p.stdout or b"[]") or []
    except ValueError:
        return []


def this_network():
    """This machine's interface with the default route: its name, MAC and global addresses, and who
    manages the network."""
    default = next((r for r in ip_json(["route", "show"]) if r.get("dst") == "default" and r.get("gateway")), {})
    dev = default.get("dev") or ""
    link = next((l for l in ip_json(["addr", "show", "dev", dev]) if l.get("ifname") == dev), {}) if dev else {}
    addrs = ["%s/%d" % (a["local"], a["prefixlen"]) for a in link.get("addr_info") or []
             if a.get("scope") == "global" and a.get("local")]
    manager = ""
    for unit in ("systemd-networkd", "NetworkManager"):
        if run(["systemctl", "is-active", "--quiet", unit], check=False).returncode == 0:
            manager = unit
            break
    if not manager and os.path.exists("/etc/network/interfaces"):
        manager = "ifupdown"
    return {"interface": dev, "mac": link.get("address", ""), "addresses": addrs, "gateway": default.get("gateway", ""),
            "hostname": socket.gethostname(), "managed_by": manager}


def ipv4_of(addrs):
    return [a for a in addrs if ":" not in a]


def bare(addrs):
    """Addresses without their prefix length, the way one connects to them."""
    return ", ".join(a.split("/")[0] for a in addrs)


def networkd_unit(old, mac, archive):
    lines = ["# Written by argus-restore: the address of the core this machine took over from",
             "# (%s, archive %s). Remove it to go back to the next file's settings." % (old.get("hostname", "?"), archive),
             "[Match]", "MACAddress=%s" % mac, "", "[Network]"]
    lines += ["Address=%s" % a for a in old.get("addresses") or []]
    lines += ["Gateway=%s" % g for g in (old.get("gateway"), old.get("gateway6")) if g]
    lines += ["DNS=%s" % d for d in old.get("dns") or []]
    if old.get("search"):
        lines.append("Domains=%s" % " ".join(old["search"]))
    for rt in old.get("routes") or []:
        lines += ["", "[Route]", "Destination=%s" % rt["to"], "Gateway=%s" % rt["via"]]
    return "\n".join(lines) + "\n"


def show_other_network_steps(old, cur):
    """Where this tool doesn't manage the network itself: the settings to enter, in that tool's words."""
    dev = cur.get("interface") or "<interface>"
    say("This machine's network is managed by %s: set it there (from the hypervisor's console, since an"
        % (cur.get("managed_by") or "an unknown tool"))
    say("SSH connection through the current address drops when it changes).")
    say()
    v4 = ipv4_of(old.get("addresses") or [])
    if cur.get("managed_by") == "ifupdown":
        say("In /etc/network/interfaces, replace the stanza of %s with:" % dev)
        say("  auto %s" % dev)
        say("  iface %s inet static" % dev)
        for a in v4:
            say("      address %s" % a)
        if old.get("gateway"):
            say("      gateway %s" % old["gateway"])
        if old.get("dns"):
            say("      dns-nameservers %s" % " ".join(old["dns"]))
        if old.get("search"):
            say("      dns-search %s" % " ".join(old["search"]))
        for rt in old.get("routes") or []:
            say("      up ip route add %s via %s" % (rt["to"], rt["via"]))
        say("then: sudo systemctl restart networking")
    elif cur.get("managed_by") == "NetworkManager":
        say("  nmcli con mod '<connection of %s>' ipv4.method manual ipv4.addresses '%s' ipv4.gateway %s ipv4.dns '%s'%s"
            % (dev, ",".join(v4), old.get("gateway") or "", " ".join(old.get("dns") or []),
               (" ipv4.dns-search '%s'" % " ".join(old["search"])) if old.get("search") else ""))
        for rt in old.get("routes") or []:
            say("  nmcli con mod '<connection of %s>' +ipv4.routes '%s %s'" % (dev, rt["to"], rt["via"]))
        say("  nmcli con up '<connection of %s>'" % dev)
    else:
        say("  address %s, gateway %s, DNS %s%s" % (", ".join(v4), old.get("gateway") or "?", ", ".join(old.get("dns") or []) or "none",
                                                  (", search %s" % " ".join(old["search"])) if old.get("search") else ""))
        for rt in old.get("routes") or []:
            say("  route %s via %s" % (rt["to"], rt["via"]))
    if old.get("hostname") and old["hostname"] != cur.get("hostname"):
        say()
        say("And the hostname: sudo hostnamectl set-hostname %s" % old["hostname"])


def take_network(work, archive, yes=False, keep_hostname=False, static=False):
    path = os.path.join(work, "network.json")
    if not os.path.exists(path):
        say("This archive has no network settings (it was made before they were kept).")
        return 1
    with open(path, encoding="utf-8") as f:
        old = json.load(f)
    cur = this_network()
    want_host = old.get("hostname") if not keep_hostname and old.get("hostname") != cur["hostname"] else ""
    say("The old core: %s on %s, gateway %s, hostname %s (%s)." % (", ".join(old.get("addresses") or []), old.get("interface"),
        old.get("gateway"), old.get("hostname"), "from DHCP" if old.get("dhcp") else "static"))
    say("This machine: %s on %s, hostname %s." % (", ".join(cur["addresses"]) or "no address", cur["interface"] or "?", cur["hostname"]))
    if set(ipv4_of(old.get("addresses") or [])) <= set(cur["addresses"]) and not want_host:
        say("This machine already answers at the old core's address.")
        return 0
    if old.get("dhcp") and not static:
        say()
        say("The old core got its address from DHCP. Give this machine the same reservation instead: move it in")
        say("the DHCP server to this machine's MAC, %s, and reboot (or renew the lease). To set it as a fixed" % (cur["mac"] or "?"))
        say("address on this machine anyway, run this again with --static.")
        if want_host:
            say("The hostname: sudo hostnamectl set-hostname %s" % want_host)
        return 0
    if cur["managed_by"] != "systemd-networkd" or not cur["mac"]:
        show_other_network_steps(old, cur)
        return 0
    unit = networkd_unit(old, cur["mac"], os.path.basename(archive))
    target = os.path.join(NETWORKD_DIR, NETWORKD_FILE)
    say()
    say("This writes %s:" % target)
    say()
    for line in unit.splitlines():
        say("  " + line)
    say()
    if want_host:
        say("and sets the hostname to %s." % want_host)
    say("Connected over SSH through %s? The connection drops when the address changes: reconnect to %s."
        % (bare(ipv4_of(cur["addresses"])) or "this machine", bare(ipv4_of(old.get("addresses") or []))))
    say("Running this from the hypervisor's console is the safest.")
    if not yes and input("Type TAKE OVER to go ahead: ").strip() != "TAKE OVER":
        say("Nothing changed.")
        return 1
    os.makedirs(NETWORKD_DIR, exist_ok=True)
    with open(target, "w", encoding="utf-8") as f:
        f.write(unit)
    os.chmod(target, 0o644)
    if want_host:
        run(["hostnamectl", "set-hostname", want_host], check=False)
    run(["networkctl", "reload"], check=False)
    run(["networkctl", "reconfigure", cur["interface"]], check=False)
    say("Done: this machine now answers at %s." % bare(ipv4_of(old.get("addresses") or [])))
    return 0


def stop_services(parts):
    say("==> stopping services")
    for unit, container in (("argus-updater", UPDATER), ("argus-core", CONTAINER)):
        if "argus" in parts or "files" in parts:
            if unit_exists(unit + ".service"):
                run(["systemctl", "stop", unit], check=False)
            run(["docker", "stop", container], check=False)
    if "zabbix" in parts or "files" in parts:
        run(["systemctl", "stop", "zabbix-server"], check=False)


def restore_files(work, manifest):
    say("==> restoring the configuration, keys and certificates")
    # PostgreSQL's own tuning stays as this machine has it (sized for its memory); the old one is in
    # the archive for reference.
    run(["tar", "-xzpf", os.path.join(work, "files.tar.gz"), "-C", "/", "--exclude=etc/postgresql"])
    # The system users' ids may differ on this machine: set the owners the stack expects.
    fixes = [
        (["chown", "-R", "zabbix:zabbix", "/etc/zabbix/certs"], "/etc/zabbix/certs"),
        (["chown", "root:www-data", "/etc/zabbix/web/zabbix.conf.php"], "/etc/zabbix/web/zabbix.conf.php"),
        (["chown", "-R", "zabbix:zabbix", "/var/lib/zabbix/ssh"], "/var/lib/zabbix/ssh"),
        (["chown", "-R", "zabbix:zabbix", "/var/lib/zabbix/argus-pins"], "/var/lib/zabbix/argus-pins"),
    ]
    for cmd, path in fixes:
        if path and os.path.exists(path):
            run(cmd, check=False)
    # The CA (the folder the old core's Argus container mounted as /ca): root's, readable by the
    # container's group only, so Argus can read it but not change it.
    ca = (manifest.get("argus_mounts") or {}).get("/ca") or "/docker/argus/pki"
    if os.path.isdir(ca):
        run(["chown", "-R", "root:%d" % APP_UID, ca], check=False)
        run(["chmod", "750", ca], check=False)
        for name, mode in (("ca.key", "440"), ("ca.crt", "444")):
            if os.path.exists(os.path.join(ca, name)):
                run(["chmod", mode, os.path.join(ca, name)], check=False)
    for d in ("/etc/argus-core",):
        if os.path.isdir(d):
            run(["chmod", "700", d], check=False)
    run(["systemctl", "daemon-reload"], check=False)


def restore_zabbix(work):
    say("==> recreating the Zabbix database (this can take a while with history)")
    run(["runuser", "-u", "postgres", "--", "psql", "-q", "-d", "postgres", "-f", os.path.join(work, "postgres-globals.sql")], check=False)
    psql("SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname='zabbix' AND pid <> pg_backend_pid()", check=False)
    run(["runuser", "-u", "postgres", "--", "dropdb", "--if-exists", "zabbix"])
    run(["runuser", "-u", "postgres", "--", "createdb", "-O", "zabbix", "zabbix"])
    psql("CREATE EXTENSION IF NOT EXISTS timescaledb", db="zabbix")
    psql("SELECT timescaledb_pre_restore()", db="zabbix")
    jobs = str(max(1, min(4, os.cpu_count() or 1)))
    log = os.path.join(work, "pg_restore.log")
    with open(log, "wb") as f:
        p = run(["runuser", "-u", "postgres", "--", "pg_restore", "-j", jobs, "-d", "zabbix", os.path.join(work, "zabbix.dump")],
                stdout=f, check=False)
        f.write(p.stderr or b"")
    psql("SELECT timescaledb_post_restore()", db="zabbix")
    run(["runuser", "-u", "postgres", "--", "vacuumdb", "--analyze-only", "-q", "-d", "zabbix"], check=False)
    with open(log, encoding="utf-8", errors="replace") as f:
        errors = [l.strip() for l in f if "error:" in l.lower()]
    if p.returncode != 0 or errors:
        keep = os.path.join(WORK_BASE, "pg_restore-%d.log" % int(time.time()))
        shutil.copyfile(log, keep)
        say("   pg_restore reported %d error line(s); the log is kept in %s" % (len(errors), keep))
        for l in errors[:5]:
            say("     " + l)
        say("   (TimescaleDB dumps can print a few harmless ones; check that Zabbix starts and shows data.)")


def restore_argus(work, manifest):
    say("==> restoring the Argus database")
    ddir = manifest.get("argus_data_dir") or "/docker/argus"
    os.makedirs(ddir, exist_ok=True)
    for suffix in ("", "-wal", "-shm"):
        try:
            os.unlink(os.path.join(ddir, "argus.db" + suffix))
        except FileNotFoundError:
            pass
    for suffix in ("", "-wal", "-shm"):
        src = os.path.join(work, "argus.db" + suffix + ".gz")
        if os.path.exists(src):
            dst = os.path.join(ddir, "argus.db" + suffix)
            with gzip.open(src, "rb") as fi, open(dst, "wb") as fo:
                shutil.copyfileobj(fi, fo, 1 << 20)
            os.chmod(dst, 0o600)
            os.chown(dst, APP_UID, APP_UID)
    os.chown(ddir, APP_UID, APP_UID)
    key = os.path.join(ddir, "secret.key")
    if os.path.exists(key):
        os.chown(key, APP_UID, APP_UID)
        os.chmod(key, 0o600)


def start_services(parts):
    say("==> starting services")
    if "zabbix" in parts or "files" in parts:
        run(["systemctl", "enable", "--now", "zabbix-server"], check=False)
        run(["systemctl", "restart", "zabbix-server"], check=False)
        run(["systemctl", "reload-or-restart", "nginx"], check=False)
    if "argus" in parts or "files" in parts:
        started = False
        for unit in ("argus-core", "argus-updater"):
            if unit_exists(unit + ".service"):
                run(["systemctl", "enable", "--now", unit], check=False)
                run(["systemctl", "restart", unit], check=False)
                started = True
        if not started:
            run(["docker", "start", CONTAINER], check=False)
            run(["docker", "start", UPDATER], check=False)
    if "files" in parts:
        p = run(["systemctl", "list-unit-files", "argus-*.timer", "--no-legend"], check=False)
        timers = [l.split()[0] for l in p.stdout.decode().splitlines() if l.split()]
        if timers:
            run(["systemctl", "enable", "--now"] + timers, check=False)
        if unit_exists("argus-backup.path"):
            run(["systemctl", "enable", "--now", "argus-backup.path"], check=False)


def main(argv):
    ap = argparse.ArgumentParser(prog="argus-restore")
    ap.add_argument("action", choices=["inspect", "containers", "network", "restore"])
    ap.add_argument("archive")
    ap.add_argument("--only", choices=["files", "zabbix", "argus"])
    ap.add_argument("--yes", action="store_true", help="don't ask for confirmation")
    ap.add_argument("--force", action="store_true", help="restore even when the versions differ")
    ap.add_argument("--passphrase-file")
    ap.add_argument("--keep-hostname", action="store_true", help="network: leave this machine's hostname as it is")
    ap.add_argument("--static", action="store_true", help="network: set an address the old core had from DHCP as fixed")
    a = ap.parse_args(argv[1:])
    if os.geteuid() != 0:
        say("argus-restore: run as root")
        return 1
    archive = os.path.abspath(a.archive)
    if not os.path.isfile(archive):
        say("argus-restore: %s is not a file" % archive)
        return 1
    os.makedirs(WORK_BASE, mode=0o700, exist_ok=True)
    work = tempfile.mkdtemp(prefix=".restore-", dir=WORK_BASE)
    try:
        manifest = unpack(archive, work, a.passphrase_file)
        if a.action == "containers":
            return show_containers(work)
        if a.action == "network":
            return take_network(work, archive, a.yes, a.keep_hostname, a.static)
        describe(manifest, archive)
        problems = version_problems(manifest)
        for p in problems:
            say("!! " + p)
        if a.action == "inspect":
            say("The archive is complete and its checksums match.")
            return 0
        parts = [a.only] if a.only else ["files", "zabbix", "argus"]
        if problems and not a.force:
            say("Not restoring over a different version (install the same versions, or pass --force).")
            return 1
        say()
        say("This replaces on this machine: %s." % ", ".join({"files": "the configuration, keys and certificates",
                                                          "zabbix": "the Zabbix database", "argus": "the Argus database"}[p] for p in parts))
        if not a.yes:
            if input("Type RESTORE to go ahead: ").strip() != "RESTORE":
                say("Nothing changed.")
                return 1
        stop_services(parts)
        if "files" in parts:
            restore_files(work, manifest)
        if "zabbix" in parts:
            restore_zabbix(work)
        if "argus" in parts:
            restore_argus(work, manifest)
        start_services(parts)
        say()
        say("Restored. Next:")
        say("  - This machine must answer where the old core did: its IP (probes dial it on :10051) and")
        say("    the Argus address people use. Probes reconnect by themselves: their CA came back with it.")
        say("  - Sign in to Argus and check Probes (all online within a few minutes) and Settings, Backups.")
        old_net = manifest.get("network") or {}
        cur = this_network()
        old_v4 = ipv4_of(old_net.get("addresses") or [])
        if old_v4 and not set(old_v4) <= set(cur["addresses"]):
            say("  - The old core was at %s (hostname %s); this machine is at %s. To take over its address and"
                % (bare(old_v4), old_net.get("hostname") or manifest.get("host", "?"), bare(ipv4_of(cur["addresses"])) or "?"))
            say("    hostname: sudo argus-restore network %s" % archive)
        else:
            say("  - The old core's hostname was %s; this one keeps its own." % manifest.get("host", "?"))
        return 0
    except Fail as e:
        say("argus-restore: %s" % e)
        return 1
    finally:
        shutil.rmtree(work, ignore_errors=True)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
