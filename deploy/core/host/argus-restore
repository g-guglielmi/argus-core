# Environment an image sets for itself: not part of how the container was run.
IMAGE_ENV = {"PATH", "HOME", "HOSTNAME", "TERM", "SSL_CERT_FILE"}


def run_command(c):
    """The docker run command that recreates a container as it ran: name, restart policy, network,
    ports, extra hosts, folders, environment and image."""
    cfg, hc = c.get("Config") or {}, c.get("HostConfig") or {}
    args = ["docker", "run", "-d", "--name", (c.get("Name") or "").lstrip("/")]
    policy = (hc.get("RestartPolicy") or {}).get("Name") or ""
    if policy and policy != "no":
        args += ["--restart", policy]
    net = hc.get("NetworkMode") or ""
    if net and net not in ("default", "bridge"):
        args += ["--network", net]
        ipam = (((c.get("NetworkSettings") or {}).get("Networks") or {}).get(net) or {}).get("IPAMConfig") or {}
        if ipam.get("IPv4Address"):
            args += ["--ip", ipam["IPv4Address"]]
    for cport, binds in sorted((hc.get("PortBindings") or {}).items()):
        port, _, proto = cport.partition("/")
        for bnd in binds or []:
            spec = ((bnd.get("HostIp") + ":") if bnd.get("HostIp") else "") + (bnd.get("HostPort") or "") + ":" + port
            args += ["-p", spec + ("/" + proto if proto and proto != "tcp" else "")]
    for h in hc.get("ExtraHosts") or []:
        args += ["--add-host", h]
    for m in c.get("Mounts") or []:
        ro = "" if m.get("RW", True) else ":ro"
        if m.get("Type") == "bind" and m.get("Source"):
            args += ["-v", "%s:%s%s" % (m["Source"], m["Destination"], ro)]
        elif m.get("Type") == "volume" and m.get("Name"):
            args += ["-v", "%s:%s%s" % (m["Name"], m["Destination"], ro)]
    for e in cfg.get("Env") or []:
        if e.split("=", 1)[0] not in IMAGE_ENV:
            args += ["-e", e]
    args.append(cfg.get("Image") or "")
    return " ".join(shlex.quote(a) for a in args)


def show_containers(work):
    path = os.path.join(work, "containers.json")
    if not os.path.exists(path):
        say("This archive has no container settings (made before they were kept, or Docker didn't say).")
        return 1
    with open(path, encoding="utf-8") as f:
        found = json.load(f)
    say("How the old core's Argus containers ran. On a core installed by hand, create them with these")
    say("(they hold the secret key and the Zabbix API token: keep this output private), then restore.")
    say("A core from the appliance image has its own units instead: restore puts their settings back.")
    for c in found:
        say()
        say(run_command(c))
    return 0


# --- the old core's address -----------------------------------------------------------------------

def ip_json(args):
    p = run(["ip", "-j"] + args, check=False)
    try:
        return json.loads(p.stdout or b"[]") or []
    except ValueError:
        return []


def this_network():
    """This machine's interface with the default route: its name, MAC and global addresses, and who
    manages the network."""
    default = next((r for r in ip_json(["route", "show"]) if r.get("dst") == "default" and r.get("gateway")), {})
    dev = default.get("dev") or ""
    link = next((l for l in ip_json(["addr", "show", "dev", dev]) if l.get("ifname") == dev), {}) if dev else {}
    addrs = ["%s/%d" % (a["local"], a["prefixlen"]) for a in link.get("addr_info") or []
             if a.get("scope") == "global" and a.get("local")]
    manager = ""
    for unit in ("systemd-networkd", "NetworkManager"):
        if run(["systemctl", "is-active", "--quiet", unit], check=False).returncode == 0:
            manager = unit
            break
    if not manager and os.path.exists("/etc/network/interfaces"):
        manager = "ifupdown"
    return {"interface": dev, "mac": link.get("address", ""), "addresses": addrs, "gateway": default.get("gateway", ""),
            "hostname": socket.gethostname(), "managed_by": manager}


def ipv4_of(addrs):
    return [a for a in addrs if ":" not in a]


def bare(addrs):
    """Addresses without their prefix length, the way one connects to them."""
    return ", ".join(a.split("/")[0] for a in addrs)


def networkd_unit(old, mac, archive):
    lines = ["# Written by argus-restore: the address of the core this machine took over from",
             "# (%s, archive %s). Remove it to go back to the next file's settings." % (old.get("hostname", "?"), archive),
             "[Match]", "MACAddress=%s" % mac, "", "[Network]"]
    lines += ["Address=%s" % a for a in old.get("addresses") or []]
    lines += ["Gateway=%s" % g for g in (old.get("gateway"), old.get("gateway6")) if g]
    lines += ["DNS=%s" % d for d in old.get("dns") or []]
    if old.get("search"):
        lines.append("Domains=%s" % " ".join(old["search"]))
    for rt in old.get("routes") or []:
        lines += ["", "[Route]", "Destination=%s" % rt["to"], "Gateway=%s" % rt["via"]]
    return "\n".join(lines) + "\n"


def show_other_network_steps(old, cur):
    """Where this tool doesn't manage the network itself: the settings to enter, in that tool's words."""
    dev = cur.get("interface") or "<interface>"
    say("This machine's network is managed by %s: set it there (from the hypervisor's console, since an"
        % (cur.get("managed_by") or "an unknown tool"))
    say("SSH connection through the current address drops when it changes).")
    say()
    v4 = ipv4_of(old.get("addresses") or [])
    if cur.get("managed_by") == "ifupdown":
        say("In /etc/network/interfaces, replace the stanza of %s with:" % dev)
        say("  auto %s" % dev)
        say("  iface %s inet static" % dev)
        for a in v4:
            say("      address %s" % a)
        if old.get("gateway"):
            say("      gateway %s" % old["gateway"])
        if old.get("dns"):
            say("      dns-nameservers %s" % " ".join(old["dns"]))
        if old.get("search"):
            say("      dns-search %s" % " ".join(old["search"]))
        for rt in old.get("routes") or []:
            say("      up ip route add %s via %s" % (rt["to"], rt["via"]))
        say("then: sudo systemctl restart networking")
    elif cur.get("managed_by") == "NetworkManager":
        say("  nmcli con mod '<connection of %s>' ipv4.method manual ipv4.addresses '%s' ipv4.gateway %s ipv4.dns '%s'%s"
            % (dev, ",".join(v4), old.get("gateway") or "", " ".join(old.get("dns") or []),
               (" ipv4.dns-search '%s'" % " ".join(old["search"])) if old.get("search") else ""))
        for rt in old.get("routes") or []:
            say("  nmcli con mod '<connection of %s>' +ipv4.routes '%s %s'" % (dev, rt["to"], rt["via"]))
        say("  nmcli con up '<connection of %s>'" % dev)
    else:
        say("  address %s, gateway %s, DNS %s%s" % (", ".join(v4), old.get("gateway") or "?", ", ".join(old.get("dns") or []) or "none",
                                                  (", search %s" % " ".join(old["search"])) if old.get("search") else ""))
        for rt in old.get("routes") or []:
            say("  route %s via %s" % (rt["to"], rt["via"]))
    if old.get("hostname") and old["hostname"] != cur.get("hostname"):
        say()
        say("And the hostname: sudo hostnamectl set-hostname %s" % old["hostname"])


def take_network(work, archive, yes=False, keep_hostname=False, static=False):
    path = os.path.join(work, "network.json")
    if not os.path.exists(path):
        say("This archive has no network settings (it was made before they were kept).")
        return 1
    with open(path, encoding="utf-8") as f:
        old = json.load(f)
    cur = this_network()
    want_host = old.get("hostname") if not keep_hostname and old.get("hostname") != cur["hostname"] else ""
    say("The old core: %s on %s, gateway %s, hostname %s (%s)." % (", ".join(old.get("addresses") or []), old.get("interface"),
        old.get("gateway"), old.get("hostname"), "from DHCP" if old.get("dhcp") else "static"))
    say("This machine: %s on %s, hostname %s." % (", ".join(cur["addresses"]) or "no address", cur["interface"] or "?", cur["hostname"]))
    if set(ipv4_of(old.get("addresses") or [])) <= set(cur["addresses"]) and not want_host:
        say("This machine already answers at the old core's address.")
        return 0
    if old.get("dhcp") and not static:
        say()
        say("The old core got its address from DHCP. Give this machine the same reservation instead: move it in")
        say("the DHCP server to this machine's MAC, %s, and reboot (or renew the lease). To set it as a fixed" % (cur["mac"] or "?"))
        say("address on this machine anyway, run this again with --static.")
        if want_host:
            say("The hostname: sudo hostnamectl set-hostname %s" % want_host)
        return 0
    if cur["managed_by"] != "systemd-networkd" or not cur["mac"]:
        show_other_network_steps(old, cur)
        return 0
    unit = networkd_unit(old, cur["mac"], os.path.basename(archive))
    target = os.path.join(NETWORKD_DIR, NETWORKD_FILE)
    say()
    say("This writes %s:" % target)
    say()
    for line in unit.splitlines():
        say("  " + line)
    say()
    if want_host:
        say("and sets the hostname to %s." % want_host)
    say("Connected over SSH through %s? The connection drops when the address changes: reconnect to %s."
        % (bare(ipv4_of(cur["addresses"])) or "this machine", bare(ipv4_of(old.get("addresses") or []))))
    say("Running this from the hypervisor's console is the safest.")
    if not yes and input("Type TAKE OVER to go ahead: ").strip() != "TAKE OVER":
        say("Nothing changed.")
        return 1
    os.makedirs(NETWORKD_DIR, exist_ok=True)
    with open(target, "w", encoding="utf-8") as f:
        f.write(unit)
    os.chmod(target, 0o644)
    if want_host:
        run(["hostnamectl", "set-hostname", want_host], check=False)
    run(["networkctl", "reload"], check=False)
    run(["networkctl", "reconfigure", cur["interface"]], check=False)
    say("Done: this machine now answers at %s." % bare(ipv4_of(old.get("addresses") or [])))
    return 0


def data_dir(manifest=None):
    """The host folder the Argus container keeps its database in: where the archive says the old core
    kept it (the restore puts it back there), else what the container mounts, else the appliance's."""
    if manifest and manifest.get("argus_data_dir"):
        return manifest["argus_data_dir"]
    try:
        mounts = json.loads(run(["docker", "inspect", "-f", "{{json .Mounts}}", CONTAINER], timeout=30).stdout) or []
    except (Fail, ValueError):
        mounts = []
    for m in mounts:
        if (m.get("Destination") or "").rstrip("/") == "/data" and m.get("Source"):
            return m["Source"]
    return "/docker/argus"


def made_at(manifest):
    """When the archive was made, unix seconds (0 when it does not say)."""
    try:
        return calendar.timegm(time.strptime(manifest.get("created_at") or "", "%Y%m%dT%H%M%SZ"))
    except (ValueError, TypeError, OverflowError):
        return 0


def argus_knows_tests(tries=1):
    """Whether the Argus container on this machine honours the test restore mark: True, False (it is older
    than test restores and would come up as a full copy), or None when it could not be asked. Its backup
    plan says so, a command every Argus with backups has."""
    for i in range(tries):
        try:
            plan = json.loads(run(["docker", "exec", CONTAINER, "/argus", "backup-plan"], timeout=60).stdout)
            return bool(isinstance(plan, dict) and plan.get("knows_test_restores"))
        except (Fail, ValueError):
            pass
        if i + 1 < tries:
            time.sleep(TEST_WAIT)
    return None


def argus_last_words():
    """The last line the Argus container logged: why it did not come up, in its own words."""
    try:
        p = run(["docker", "logs", "--tail", "1", CONTAINER], check=False, timeout=30)
    except (Fail, subprocess.TimeoutExpired):
        return ""
    lines = ((p.stdout or b"") + (p.stderr or b"")).decode("utf-8", "replace").strip().splitlines()
    if not lines:
        return ""
    try:
        return str(json.loads(lines[-1]).get("msg") or lines[-1])
    except (ValueError, AttributeError):
        return lines[-1]


def stop_argus():
    if unit_exists("argus-core.service"):
        run(["systemctl", "stop", "argus-core"], check=False)
    run(["docker", "stop", CONTAINER], check=False)


def is_test(ddir):
    return os.path.exists(os.path.join(ddir, TEST_MARK))


def set_test(ddir, manifest, archive):
    """Mark this core as a test restore, before anything of it starts. A mark that cannot be written stops
    the restore: a copy must never come up as the real core by accident."""
    os.makedirs(ddir, exist_ok=True)
    mark = os.path.join(ddir, TEST_MARK)
    try:
        with open(mark + ".tmp", "w", encoding="utf-8") as f:
            json.dump({"since": int(time.time()), "archive": os.path.basename(archive), "from": manifest.get("host", ""),
                       "made_at": made_at(manifest)}, f)
        os.chmod(mark + ".tmp", 0o644)
        os.replace(mark + ".tmp", mark)
    except OSError as e:
        raise Fail("could not mark this core as a test restore in %s (%s): nothing was restored" % (ddir, e))


def end_test(ddir):
    """Remove the mark. True when there was one."""
    try:
        os.unlink(os.path.join(ddir, TEST_MARK))
        return True
    except FileNotFoundError:
        return False


def go_live(yes=False):
    ddir = data_dir()
    if not is_test(ddir):
        say("This core is not a test restore: nothing to end.")
        return 0
    say("This core is a test restore: it alerts nobody, mails no reports, sends no syslog, holds the")
    say("heartbeat and exports no backups.")
    say()
    say("Ending the test makes it the real core: within seconds it alerts through its channels for")
    say("whatever is open, and from then on pings the heartbeat, mails the scheduled reports and exports")
    say("its backups. Do this only when the old core is gone for good: two cores with the same probes")
    say("and channels must never run side by side.")
    if not yes and input("Type GO LIVE to go ahead: ").strip() != "GO LIVE":
        say("Nothing changed.")
        return 1
    end_test(ddir)
    say("The test is over: this is a real core now (no restart needed).")
    say("If it should answer at the old core's address: sudo argus-restore network ARCHIVE")
    return 0


def stop_services(parts):
    say("==> stopping services")
    for unit, container in (("argus-updater", UPDATER), ("argus-core", CONTAINER)):
        if "argus" in parts or "files" in parts:
            if unit_exists(unit + ".service"):
                run(["systemctl", "stop", unit], check=False)
            run(["docker", "stop", container], check=False)
    if "zabbix" in parts or "files" in parts:
        run(["systemctl", "stop", "zabbix-server"], check=False)


# The host tools and their units, as an archive carries them. On the machine a restore runs on they
# are this machine's own: at least as new as the archive's (this very tool is one of them) and made
# for its layout. The first real restore put the old core's copies over them, its older
# argus-restore included.
OWN_GLOBS = ("usr/local/sbin/argus-*", "etc/systemd/system/argus-*")


def kept_tools(members, exists=os.path.lexists):
    """The files of the archive this machine keeps its own copy of: host tools and units it already
    has. One it does not have (a unit somebody added by hand) still comes back from the archive."""
    keep = []
    for m in members:
        name = m[2:] if m.startswith("./") else m
        if not name or name.endswith("/"):
            continue
        if any(fnmatch.fnmatch(name, g) for g in OWN_GLOBS) and exists("/" + name):
            keep.append(name)
    return keep


# --- a core that kept its settings in its container, restored onto a machine that keeps them in a file ---
# A core from the appliance image runs Argus from a unit that reads /etc/argus-core/argus.env, and that
# file comes back with the archive's files. A core whose containers were made by hand (docker run -e)
# has no such file: its key, its Zabbix API token and the rest are in the container, which the archive
# keeps in containers.json. Restored onto an appliance, the machine's own argus.env stayed, with the
# key and the token of its first boot: Argus refused the restored database ("at-rest encryption key
# does not match the database"), and its token is not one the restored Zabbix knows.
ARGUS_ENV = os.environ.get("ARGUS_ENV_FILE", "/etc/argus-core/argus.env")
# What a machine decides for itself, whatever core it carries: where its own Zabbix answers and where
# its unit mounts the folders. These never come from the old core. A container made by hand often
# reaches Zabbix by the core's address on the network: a test restore that took that over would drive
# the real core's Zabbix with a token that works there.
OWN_SETTINGS = {"ARGUS_ZABBIX_API_URL", "ARGUS_ZABBIX_CA_FILE", "ARGUS_UPDATE_DIR", "ARGUS_CA_CERT_FILE", "ARGUS_CA_KEY_FILE",
                "ARGUS_DATA_DIR", "ARGUS_LISTEN", "ARGUS_CHART_OUT"}
# Settings for one start only: the first admin's seed (the users come back with the database) and the
# switch that drops the stored secrets.
ONCE_SETTINGS = {"ARGUS_ADMIN_EMAIL", "ARGUS_ADMIN_PASSWORD", "ARGUS_SECRET_KEY_RESET"}


def adopted_env(text, old_env):
    """This machine's env file for the old core's Argus: (the new text, the names taken over).

    Of the machine's own lines the comments and its own settings stay (OWN_SETTINGS); every other one
    belonged to the Argus it was set up with and goes. Of the old container's ARGUS_ settings all come
    over but the machine's own and the one-time ones. Docker reads the file as plain NAME=VALUE lines,
    so a value that holds a line break cannot be written and is left out."""
    keep = []
    for line in text.splitlines():
        name = line.split("=", 1)[0].strip()
        if not line.strip() or line.lstrip().startswith("#") or "=" not in line or name in OWN_SETTINGS:
            keep.append(line)
    taken = {}
    for e in old_env or []:
        name, eq, value = e.partition("=")
        if eq and name.startswith("ARGUS_") and name not in OWN_SETTINGS | ONCE_SETTINGS and "\n" not in value and "\r" not in value:
            taken[name] = value
    out = keep + ["", "# The restored core's own settings, from its container as the archive kept it (argus-restore)."]
    out += ["%s=%s" % (n, taken[n]) for n in sorted(taken)]
    return "\n".join(out) + "\n", sorted(taken)


def adopt_container_settings(work, members):
    """Give this machine's Argus the settings of a core that kept them in its container. Nothing to do
    when the machine has no env file (its containers are made by hand: argus-restore containers), or
    when the archive brought one (a core from the appliance image)."""
    if not os.path.isfile(ARGUS_ENV) or "etc/argus-core/argus.env" in members:
        return
    old = None
    try:
        with open(os.path.join(work, "containers.json"), encoding="utf-8") as f:
            for c in json.load(f):
                if (c.get("Name") or "").lstrip("/") == CONTAINER:
                    old = (c.get("Config") or {}).get("Env") or []
    except (OSError, ValueError, AttributeError, TypeError):
        pass
    if old is None:
        say("!! the archive does not say how the old core's Argus was set up (no %s and no container settings in it):" % ARGUS_ENV)
        say("   %s stays this machine's own. Argus refuses the restored database unless" % ARGUS_ENV)
        say("   ARGUS_SECRET_KEY and ARGUS_ZABBIX_API_TOKEN in it are the old core's.")
        return
    with open(ARGUS_ENV, encoding="utf-8") as f:
        text = f.read()
    new, names = adopted_env(text, old)
    was = ARGUS_ENV + ".before-restore"
    with open(os.open(was, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w", encoding="utf-8", newline="\n") as f:
        f.write(text)
    tmp = ARGUS_ENV + ".tmp"
    with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w", encoding="utf-8", newline="\n") as f:
        f.write(new)
    os.replace(tmp, ARGUS_ENV)
    say("   the old core kept its Argus settings in its container: %d of them now are in %s" % (len(names), ARGUS_ENV))
    say("   (%s). The Zabbix address and the folders stay this machine's own;" % ", ".join(names))
    say("   the file as it was is kept as %s." % was)


def restore_files(work, manifest):
    say("==> restoring the configuration, keys and certificates")
    files = os.path.join(work, "files.tar.gz")
    # PostgreSQL's own tuning stays as this machine has it (sized for its memory); the old one is in
    # the archive for reference.
    cmd = ["tar", "-xzpf", files, "-C", "/", "--exclude=etc/postgresql"]
    listing = run(["tar", "-tzf", files], check=False)
    members = [m[2:] if m.startswith("./") else m for m in listing.stdout.decode("utf-8", "replace").splitlines()] if listing.returncode == 0 else []
    own = kept_tools(members)
    if own:
        skip = os.path.join(work, "keep-own.list")
        with open(skip, "w", encoding="utf-8", newline="\n") as f:
            f.write("\n".join(own) + "\n")
        cmd += ["--anchored", "--no-wildcards", "--exclude-from=" + skip]
        say("   this machine keeps its own host tools and units (%d files of the archive are left out)" % len(own))
    run(cmd)
    # The system users' ids may differ on this machine: set the owners the stack expects.
    fixes = [
        (["chown", "-R", "zabbix:zabbix", "/etc/zabbix/certs"], "/etc/zabbix/certs"),
        (["chown", "root:www-data", "/etc/zabbix/web/zabbix.conf.php"], "/etc/zabbix/web/zabbix.conf.php"),
        (["chown", "-R", "zabbix:zabbix", "/var/lib/zabbix/ssh"], "/var/lib/zabbix/ssh"),
        (["chown", "-R", "zabbix:zabbix", "/var/lib/zabbix/argus-pins"], "/var/lib/zabbix/argus-pins"),
    ]
    for cmd, path in fixes:
        if path and os.path.exists(path):
            run(cmd, check=False)
    # The CA (the folder the old core's Argus container mounted as /ca): root's, readable by the
    # container's group only, so Argus can read it but not change it.
    ca = (manifest.get("argus_mounts") or {}).get("/ca") or "/docker/argus/pki"
    if os.path.isdir(ca):
        run(["chown", "-R", "root:%d" % APP_UID, ca], check=False)
        run(["chmod", "750", ca], check=False)
        for name, mode in (("ca.key", "440"), ("ca.crt", "444")):
            if os.path.exists(os.path.join(ca, name)):
                run(["chmod", mode, os.path.join(ca, name)], check=False)
    for d in ("/etc/argus-core",):
        if os.path.isdir(d):
            run(["chmod", "700", d], check=False)
    adopt_container_settings(work, members)
    run(["systemctl", "daemon-reload"], check=False)


def restore_zabbix(work):
    say("==> recreating the Zabbix database (this can take a while with history)")
    # The roles and the dump sit in a folder only root opens, and psql and pg_restore run as postgres:
    # each gets its file on its standard input, opened here, never as a path. A path ended the first
    # real restore on "could not open input file ...: Permission denied", with an empty database.
    with open(os.path.join(work, "postgres-globals.sql"), "rb") as src:
        run(["runuser", "-u", "postgres", "--", "psql", "-q", "-d", "postgres"], stdin=src, check=False)
    psql("SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname='zabbix' AND pid <> pg_backend_pid()", check=False)
    run(["runuser", "-u", "postgres", "--", "dropdb", "--if-exists", "zabbix"])
    run(["runuser", "-u", "postgres", "--", "createdb", "-O", "zabbix", "zabbix"])
    psql("CREATE EXTENSION IF NOT EXISTS timescaledb", db="zabbix")
    psql("SELECT timescaledb_pre_restore()", db="zabbix")
    # One job, never -j: a parallel restore loads TimescaleDB's own catalog tables in an order that
    # breaks their foreign keys (chunks before their hypertable), the catalog comes back incomplete
    # and the hypertables with it. TimescaleDB's documentation says the same: no -j.
    log = os.path.join(work, "pg_restore.log")
    with open(log, "wb") as f, open(os.path.join(work, "zabbix.dump"), "rb") as src:
        p = run(["runuser", "-u", "postgres", "--", "pg_restore", "-d", "zabbix"], stdin=src, stdout=f, check=False)
        f.write(p.stderr or b"")
    psql("SELECT timescaledb_post_restore()", db="zabbix")
    run(["runuser", "-u", "postgres", "--", "vacuumdb", "--analyze-only", "-q", "-d", "zabbix"], check=False)
    # What pg_restore says is one thing, what the database holds is the other: Zabbix's own tables
    # are there, or the dump did not load and nothing may start on it.
    have = psql("SELECT count(*) FROM information_schema.tables WHERE table_schema = 'public' "
                "AND table_name IN ('dbversion', 'hosts', 'items')", db="zabbix", check=False)
    loaded = have.returncode == 0 and have.stdout.decode().strip() == "3"
    with open(log, encoding="utf-8", errors="replace") as f:
        errors = [l.strip() for l in f if "error:" in l.lower()]
    keep = ""
    if p.returncode != 0 or errors or not loaded:
        keep = os.path.join(WORK_BASE, "pg_restore-%d.log" % int(time.time()))
        shutil.copyfile(log, keep)
        say("   pg_restore reported %d error line(s); the log is kept in %s" % (len(errors), keep))
        for l in errors[:5]:
            say("     " + l)
    if not loaded:
        raise Fail("the Zabbix database did not load: its tables are not there, so nothing was started (%s). "
                   "The log is in %s" % (errors[0] if errors else "pg_restore ended with %d" % p.returncode, keep))
    if keep:
        # A table whose rows did not load is never harmless: the database is not what was backed up.
        lost = [l for l in errors if "COPY failed" in l]
        if lost:
            raise Fail("%d table(s) of the Zabbix database did not load, so it is NOT complete and nothing was started. "
                       "The log is in %s" % (len(lost), keep))
        say("   (TimescaleDB dumps can print a few harmless ones; check that Zabbix starts and shows data.)")


def restore_argus(work, manifest):
    say("==> restoring the Argus database")
    ddir = manifest.get("argus_data_dir") or "/docker/argus"
    os.makedirs(ddir, exist_ok=True)
    for suffix in ("", "-wal", "-shm"):
        try:
            os.unlink(os.path.join(ddir, "argus.db" + suffix))
        except FileNotFoundError:
            pass
    for suffix in ("", "-wal", "-shm"):
        src = os.path.join(work, "argus.db" + suffix + ".gz")
        if os.path.exists(src):
            dst = os.path.join(ddir, "argus.db" + suffix)
            with gzip.open(src, "rb") as fi, open(dst, "wb") as fo:
                shutil.copyfileobj(fi, fo, 1 << 20)
            os.chmod(dst, 0o600)
            os.chown(dst, APP_UID, APP_UID)
    os.chown(ddir, APP_UID, APP_UID)
    key = os.path.join(ddir, "secret.key")
    if os.path.exists(key):
        os.chown(key, APP_UID, APP_UID)
        os.chmod(key, 0o600)


def start_services(parts):
    say("==> starting services")
    if "zabbix" in parts or "files" in parts:
        run(["systemctl", "enable", "--now", "zabbix-server"], check=False)
        run(["systemctl", "restart", "zabbix-server"], check=False)
        run(["systemctl", "reload-or-restart", "nginx"], check=False)
    if "argus" in parts or "files" in parts:
        started = False
        for unit in ("argus-core", "argus-updater"):
            if unit_exists(unit + ".service"):
                run(["systemctl", "enable", "--now", unit], check=False)
                run(["systemctl", "restart", unit], check=False)
                started = True
        if not started:
            run(["docker", "start", CONTAINER], check=False)
            run(["docker", "start", UPDATER], check=False)
    if "files" in parts:
        p = run(["systemctl", "list-unit-files", "argus-*.timer", "--no-legend"], check=False)
        timers = [l.split()[0] for l in p.stdout.decode().splitlines() if l.split()]
        if timers:
            run(["systemctl", "enable", "--now"] + timers, check=False)
        if unit_exists("argus-backup.path"):
            run(["systemctl", "enable", "--now", "argus-backup.path"], check=False)


def main(argv):
    ap = argparse.ArgumentParser(prog="argus-restore")
    ap.add_argument("action", choices=["inspect", "containers", "network", "restore", "live"])
    ap.add_argument("archive", nargs="?")
    ap.add_argument("--test", action="store_true",
                    help="restore: a test next to the running core; the copy sends and exports nothing")
    ap.add_argument("--only", choices=["files", "zabbix", "argus"])
    ap.add_argument("--yes", action="store_true", help="don't ask for confirmation")
    ap.add_argument("--force", action="store_true", help="restore even when the versions differ")
    ap.add_argument("--passphrase-file")
    ap.add_argument("--keep-hostname", action="store_true", help="network: leave this machine's hostname as it is")
    ap.add_argument("--static", action="store_true", help="network: set an address the old core had from DHCP as fixed")
    a = ap.parse_args(argv[1:])
    if os.geteuid() != 0:
        say("argus-restore: run as root")
        return 1
    if a.action == "live":
        try:
            return go_live(a.yes)
        except Fail as e:
            say("argus-restore: %s" % e)
            return 1
    if not a.archive:
        say("argus-restore: %s needs the archive to work from" % a.action)
        return 1
    if a.test and (a.action != "restore" or a.only):
        say("argus-restore: --test goes with a whole restore (restore ARCHIVE --test), not with %s"
            % ("--only" if a.action == "restore" else a.action))
        return 1
    archive = os.path.abspath(a.archive)
    if not os.path.isfile(archive):
        say("argus-restore: %s is not a file" % archive)
        return 1
    os.makedirs(WORK_BASE, mode=0o700, exist_ok=True)
    work = tempfile.mkdtemp(prefix=".restore-", dir=WORK_BASE)
    try:
        manifest = unpack(archive, work, a.passphrase_file)
        if a.action == "containers":
            return show_containers(work)
        if a.action == "network":
            if is_test(data_dir(manifest)):
                say("This core is a test restore: it must not take the real core's address.")
                say("When the old core is gone for good, end the test first: sudo argus-restore live")
                return 1
            return take_network(work, archive, a.yes, a.keep_hostname, a.static)
        describe(manifest, archive)
        parts = [a.only] if a.only else ["files", "zabbix", "argus"]
        # TimescaleDB on another version than the dump needs: the restore installs that one first,
        # when the repository has it and the Zabbix database is among what is restored.
        fit = timescaledb_fit(manifest) if a.action == "inspect" or "zabbix" in parts else ""
        problems = version_problems(manifest, timescaledb=not fit)
        for p in problems:
            say("!! " + p)
        if fit:
            say("TimescaleDB here is %s, the backup was made on %s: the restore installs %s first and holds"
                % (bare_version(installed_versions().get(TS_META, "")), timescaledb_wanted(manifest), bare_version(fit)))
            say("the packages on the %s line. Zabbix on this machine must support that line." % major_minor(fit))
        if a.action == "inspect":
            say("The archive is complete and its checksums match.")
            return 0
        if problems and not a.force:
            say("Not restoring over a different version (install the same versions, or pass --force).")
            return 1
        say()
        say("This replaces on this machine: %s." % ", ".join({"files": "the configuration, keys and certificates",
                                                          "zabbix": "the Zabbix database", "argus": "the Argus database"}[p] for p in parts))
        ddir = data_dir(manifest)
        if a.test:
            knows = argus_knows_tests()
            if knows is False:
                say("No test restore on this machine yet: its Argus does not know test restores, so the copy would come up as a")
                say("full core and alert through the real channels. Update it first (Updates: Argus and Host")
                say("tools on the current release), then run this again.")
                return 1
            if knows is None:
                say("No test restore on this machine yet: its Argus could not be asked whether it knows them (is the")
                say("container running?), and a copy that does not would alert through the real channels.")
                say("Start it, or update it, then run this again.")
                return 1
            say("A TEST RESTORE: the copy alerts nobody, mails no reports, sends no syslog, holds the heartbeat and")
            say("exports no backups, and it never takes the old core's address. Its probes will read offline:")
            say("they keep talking to the real core. The real core is not touched.")
        elif not a.only:
            say("This machine comes up as the old core's full copy: it alerts through the same channels and")
            say("exports to the same backup target. The old core must be off, or gone. To try a backup next")
            say("to a core that still runs, stop here and add --test.")
        if not a.yes:
            if input("Type RESTORE to go ahead: ").strip() != "RESTORE":
                say("Nothing changed.")
                return 1
        stop_services(parts)
        # The mark goes in first, so that nothing of a test restore ever starts without it; a real, whole
        # restore on a machine that was a test restore ends the test. --only leaves it as it is.
        if a.test:
            set_test(ddir, manifest, archive)
        elif not a.only and end_test(ddir):
            say("   (this machine was a test restore: it is a real core from here on)")
        if fit and "zabbix" in parts:
            try:
                install_timescaledb(fit)
            except Fail:
                start_services(parts)
                raise
        if "files" in parts:
            restore_files(work, manifest)
        if "zabbix" in parts:
            restore_zabbix(work)
        if "argus" in parts:
            restore_argus(work, manifest)
        start_services(parts)
        # Is the Argus that came back up, and (for a test) does it honour the mark? Asked for a minute.
        answer = argus_knows_tests(tries=12) if ("argus" in parts or "files" in parts) else True
        words = argus_last_words() if answer is None else ""
        why = " Its log ends with: %s." % words.rstrip(".") if words else " sudo docker logs argus says why."
        if a.test and not answer:
            # No answer, or an image that does not know test restores (a version the old core was
            # pinned to): stop it before its first alert rather than trust it.
            stop_argus()
            if answer is None:
                raise Fail("the databases and files are restored, but Argus did not come up on them, so it was stopped; "
                           "nothing was sent." + why)
            raise Fail("the Argus that started after the restore does not confirm it is a test restore (the old core's "
                       "settings may pin an older version), so it was stopped before it could alert anyone. "
                       "Everything is restored; nothing was sent")
        if answer is None:
            raise Fail("the databases and files are restored, but Argus did not come up on them." + why)
        say()
        if a.test:
            cur = this_network()
            say("Restored as a test. Next:")
            say("  - Sign in at https://%s/ with your own user (the browser warns: the certificate names the"
                % (bare(ipv4_of(cur["addresses"])) or "<this machine>"))
            say("    real core). Every page says this is a test restore.")
            made = made_at(manifest)
            say("  - Look at a few hosts and their charts up to %s, when the backup was made."
                % (time.strftime("%Y-%m-%d %H:%M UTC", time.gmtime(made)) if made else "the time"))
            say("    Probes read offline here: they still talk to the real core.")
            say("  - Then delete this machine and its disk, and every copy of the archive made on the way: it")
            say("    holds every secret of the core.")
            say("  - Should the real core be lost meanwhile: sudo argus-restore live makes this one real.")
            return 0
        say("Restored. Next:")
        say("  - This machine must answer where the old core did: its IP (probes dial it on :10051) and")
        say("    the Argus address people use. Probes reconnect by themselves: their CA came back with it.")
        say("  - Sign in to Argus and check Probes (all online within a few minutes) and Settings, Backups.")
        old_net = manifest.get("network") or {}
        cur = this_network()
        old_v4 = ipv4_of(old_net.get("addresses") or [])
        if old_v4 and not set(old_v4) <= set(cur["addresses"]):
            say("  - The old core was at %s (hostname %s); this machine is at %s. To take over its address and"
                % (bare(old_v4), old_net.get("hostname") or manifest.get("host", "?"), bare(ipv4_of(cur["addresses"])) or "?"))
            say("    hostname: sudo argus-restore network %s" % archive)
        else:
            say("  - The old core's hostname was %s; this one keeps its own." % manifest.get("host", "?"))
        return 0
    except Fail as e:
        say("argus-restore: %s" % e)
        return 1
    finally:
        shutil.rmtree(work, ignore_errors=True)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
