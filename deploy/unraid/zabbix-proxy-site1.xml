<?xml version="1.0"?>
<!--
  unRAID Community Applications template - Zabbix active proxy for site "site1".
  Import via Docker tab -> Add Container -> Template dropdown, or Apps -> paste template.
  Duplicate this file and change site1 -> <site> for other unRAID hosts (e.g. site2).

  Before starting:
    1. Put ca.crt + proxy-site1.crt + proxy-site1.key in the Certs path below.
    2. Set "Zabbix Server (core)" to your core's FQDN or IP.
    3. Register an ACTIVE proxy named "proxy-site1" (certificate encryption) in the Zabbix UI.
  No inbound port is needed - an active proxy dials out to the core.
-->
<Container version="2">
  <Name>Zabbix-Proxy-site1</Name>
  <Repository>zabbix/zabbix-proxy-sqlite3:alpine-7.0-latest</Repository>
  <Registry>https://hub.docker.com/r/zabbix/zabbix-proxy-sqlite3/</Registry>
  <Network>bridge</Network>
  <Privileged>false</Privileged>
  <Overview>Zabbix active proxy for site site1. Collects locally, buffers up to 7 days if the core is unreachable, and pushes to the core over mutual TLS.</Overview>
  <Category>Tools: Network:Management</Category>
  <Icon>https://assets.zabbix.com/img/logo/zabbix_logo_500x131.png</Icon>
  <Config Name="Proxy mode" Target="ZBX_PROXYMODE" Default="0" Mode="" Description="0 = active (proxy dials out to the core). Leave at 0." Type="Variable" Display="advanced" Required="true" Mask="false">0</Config>
  <Config Name="Zabbix Server (core)" Target="ZBX_SERVER_HOST" Default="core.example.lan" Mode="" Description="FQDN or IP of the core (must be reachable on TCP 10051)." Type="Variable" Display="always" Required="true" Mask="false"></Config>
  <Config Name="Proxy name" Target="ZBX_HOSTNAME" Default="proxy-site1" Mode="" Description="Must match the proxy name registered in the Zabbix UI." Type="Variable" Display="always" Required="true" Mask="false">proxy-site1</Config>
  <Config Name="Offline buffer (hours)" Target="ZBX_PROXYOFFLINEBUFFER" Default="168" Mode="" Description="How long to keep unsent data if the core is down. 168 = 7 days." Type="Variable" Display="advanced" Required="true" Mask="false">168</Config>
  <Config Name="TLS connect" Target="ZBX_TLSCONNECT" Default="cert" Mode="" Description="Use certificate-based mutual TLS." Type="Variable" Display="advanced" Required="true" Mask="false">cert</Config>
  <Config Name="TLS accept" Target="ZBX_TLSACCEPT" Default="cert" Mode="" Description="Accept only certificate-based TLS." Type="Variable" Display="advanced" Required="true" Mask="false">cert</Config>
  <Config Name="TLS CA file" Target="ZBX_TLSCAFILE" Default="/certs/ca.crt" Mode="" Description="" Type="Variable" Display="advanced" Required="true" Mask="false">/certs/ca.crt</Config>
  <Config Name="TLS cert file" Target="ZBX_TLSCERTFILE" Default="/certs/proxy-site1.crt" Mode="" Description="" Type="Variable" Display="advanced" Required="true" Mask="false">/certs/proxy-site1.crt</Config>
  <Config Name="TLS key file" Target="ZBX_TLSKEYFILE" Default="/certs/proxy-site1.key" Mode="" Description="" Type="Variable" Display="advanced" Required="true" Mask="false">/certs/proxy-site1.key</Config>
  <Config Name="Pin server cert issuer" Target="ZBX_TLSSERVERCERTISSUER" Default="CN=Monitoring Core CA" Mode="" Description="Only trust a core cert from this CA." Type="Variable" Display="advanced" Required="false" Mask="false">CN=Monitoring Core CA</Config>
  <Config Name="Pin server cert subject" Target="ZBX_TLSSERVERCERTSUBJECT" Default="CN=zabbix-core" Mode="" Description="Only trust this exact core cert subject." Type="Variable" Display="advanced" Required="false" Mask="false">CN=zabbix-core</Config>
  <Config Name="Certs" Target="/certs" Default="/mnt/user/appdata/zbx-proxy-site1/certs" Mode="ro" Description="Folder holding ca.crt, proxy-site1.crt, proxy-site1.key." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/zbx-proxy-site1/certs</Config>
  <Config Name="Data (SQLite spool)" Target="/var/lib/zabbix" Default="/mnt/user/appdata/zbx-proxy-site1/data" Mode="rw" Description="Persistent offline buffer / SQLite DB." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/zbx-proxy-site1/data</Config>
  <Config Name="SNMP traps" Target="/var/lib/zabbix/snmptraps" Default="/mnt/user/appdata/zbx-proxy-site1/data/snmptraps" Mode="rw" Description="The base Zabbix image marks this path as a VOLUME; bind it into appdata so Docker doesn't create an anonymous volume for it." Type="Path" Display="advanced" Required="false" Mask="false">/mnt/user/appdata/zbx-proxy-site1/data/snmptraps</Config>
</Container>
