# Secrets
*.env
!argus/.env.example
argus/pki/out/
deploy/pki/out/

# Go
argus/argus
argus/**/*.test
# go.sum is generated by `go mod tidy` at Docker build time (go.mod is kept minimal), not committed
argus/go.sum

# Node / Vite
argus/web/node_modules/
argus/web/dist/*
!argus/web/dist/.gitkeep
# package-lock is a local-install artifact; the Docker build runs `npm install` and doesn't need it
argus/web/package-lock.json

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Claude Code local settings (machine-specific)
.claude/settings.local.json

# Local archives / transfer bundles
*.zip

# Private local crosswalk (real infra values) - never publish
LOCAL-VALUES.md
